# Web3 Constellation Environment Variables
# Copy this file to .env.local and fill in your values

# Alchemy API Key (optional - app works with simulation mode)
VITE_ALCHEMY_API_KEY=your_alchemy_api_key_here

# Etherscan API Key (optional - for contract data)
VITE_ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Hugging Face API Key (optional - for AI contract summaries)
VITE_HUGGING_FACE_API_KEY=your_hugging_face_api_key_here

# OpenAI API Key (optional - alternative for AI summaries)
VITE_OPENAI_API_KEY=your_openai_api_key_here

# Environment
VITE_NODE_ENV=production